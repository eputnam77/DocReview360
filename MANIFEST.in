# MANIFEST.in — controls what goes into the source distribution (sdist)
# ---------------------------------------------------------------------------
# Include essential release artifacts
include README.md
include LICENSE
include pyproject.toml
include setup.py

# Include runtime source tree. Optional ML model artifacts and frontend source
# are intentionally excluded from the source distribution.
recursive-include src/docreview360 *.py *.json *.html *.sql *.tf *.txt

# Explicitly exclude things that must NOT ship in sdist
# NOTE: The source distribution does not include the frontend source tree.
prune src/docreview360/scripts
prune tests
prune frontend/node_modules
prune frontend/.next
prune frontend/.tmp
prune frontend/__tests__
prune frontend/scripts
prune frontend
prune scripts
prune docs
prune artifacts
prune archive_store
prune tamper_proof_store
prune .claude
prune .git

exclude frontend/data/mock.js
exclude frontend/data/mock.ts
exclude frontend/public/sample.txt

# Exclude individual junk files
global-exclude *.pyc
global-exclude __pycache__
global-exclude *.log
global-exclude *.lock
global-exclude .env
global-exclude .env.*
global-exclude node_modules
global-exclude *.db
global-exclude *.sqlite
global-exclude *.tmp
global-exclude *.tsbuildinfo
global-exclude *.onnx
global-exclude *.pt
global-exclude *.pkl
