# MANIFEST.in — controls what goes into the source distribution (sdist)
# ---------------------------------------------------------------------------
# Include essential release artifacts
include README.md
include LICENSE
include pyproject.toml
include setup.py

# Include runtime source tree
recursive-include src/docreview360 *.py *.json *.html *.sql *.tf *.onnx

# Include the frontend source tree for source distributions so pip can rebuild a
# wheel with the bundled alpha UI without checking out the repository.
graft frontend

# Explicitly exclude things that must NOT ship in sdist
# NOTE: The source distribution includes the frontend source tree, but generated
# build artefacts and local runtime state are pruned below.
prune src/docreview360/scripts
prune tests
prune .dev
prune frontend/node_modules
prune frontend/.next
prune frontend/.tmp
prune scripts
prune docs
prune artifacts
prune .claude
prune .git

# Exclude individual junk files
global-exclude *.pyc
global-exclude __pycache__
global-exclude *.log
global-exclude *.lock
global-exclude .env
global-exclude .env.*
global-exclude node_modules
global-exclude *.db
global-exclude *.sqlite
global-exclude *.tmp
