# Frontend (Next.js)
NEXT_PUBLIC_API_BASE=http://localhost:8000 # leave blank to use dashboard host

# CORS
DOCREVIEW360_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Auth + tokens
DOCREVIEW360_ENV=dev
DOCREVIEW360_SECRET_KEY=your-secret
# Set during key rotation — tokens signed with the old key remain valid for
# DOCREVIEW360_ACCESS_EXPIRE_MINUTES after rotation. Clear once old tokens expire.
# DOCREVIEW360_SECRET_KEY_PREVIOUS=old-secret
DOCREVIEW360_ALGORITHM=HS256
DOCREVIEW360_ACCESS_EXPIRE_MINUTES=30
DOCREVIEW360_TOKEN_ISSUER=docreview360.local
DOCREVIEW360_TOKEN_AUDIENCE=docreview360-users
DOCREVIEW360_OIDC_SECRET_KEY=your-oidc-secret
DOCREVIEW360_OIDC_ALGORITHM=HS256
DOCREVIEW360_OIDC_EXPIRE_MINUTES=30
DOCREVIEW360_OIDC_TOKEN_ISSUER=docreview360-oidc.local
DOCREVIEW360_OIDC_TOKEN_AUDIENCE=docreview360-oidc
DOCREVIEW360_REQUIRE_MFA=false
DOCREVIEW360_SEED_DEMO_USERS=true
DOCREVIEW360_MAX_FAILED_ATTEMPTS=5
DOCREVIEW360_LOCKOUT_SECONDS=300
DOCREVIEW360_USER_DB=./docreview360_users.db

# Database + storage
# DOCREVIEW360_DATABASE_URL=sqlite:///./docreview360.db
DOCREVIEW360_RBAC_DB=./docreview360_roles.db
DOCREVIEW360_SEARCH_DB=./search_state.db
DOCREVIEW360_ARCHIVE_BUCKET=./archive_store
DOCREVIEW360_SAMPLE_DIR=./samples
# DOCREVIEW360_DATA_DIR=.
# DOCREVIEW360_DOC_TYPES_FILE removed (Tier 2e): doc types now live in the main database
# DOCREVIEW360_PHASES_FILE removed (Tier 2e): phases now live in the main database
DOCREVIEW360_WORKFLOW_TEMPLATES_FILE=./workflow_templates.json
DOCREVIEW360_TEMPLATE_STORE_FILE=./template_store.json
DOCREVIEW360_TEMPLATES_DIR=./templates/golden
DOCREVIEW360_SETTINGS_FILE=./settings.yaml
DOCREVIEW360_CONFIG_FILE=./docreview360.yaml
DOCREVIEW360_ENVIRONMENTS_FILE=./environments.yaml
DOCREVIEW360_WORKER_STATE=./worker_state.json

# Feature flags
# DOCREVIEW360_ENABLE_DOC_TYPE_PERSISTENCE removed (Tier 2e): always DB-backed
# DOCREVIEW360_ENABLE_PHASE_PERSISTENCE removed (Tier 2e): always DB-backed
# DOCREVIEW360_ENABLE_TEMPLATE_PERSISTENCE=true
# DOCREVIEW360_ENABLE_EMAIL_TEMPLATE_PERSISTENCE=true
# DOCREVIEW360_ENABLE_WORKFLOW_TEMPLATE_PERSISTENCE=true
# DOCREVIEW360_SKIP_SAMPLE_BOOTSTRAP=1
# DOCREVIEW360_ENABLE_SAMPLE_BOOTSTRAP=1

# API rate limits
DOCREVIEW360_RATE_LIMIT_WINDOW_SECONDS=60
DOCREVIEW360_TOKEN_RATE_LIMIT=20
DOCREVIEW360_LOGIN_RATE_LIMIT=20
DOCREVIEW360_UPLOAD_RATE_LIMIT=30
DOCREVIEW360_EXPORT_RATE_LIMIT=20
DOCREVIEW360_SEARCH_RATE_LIMIT=60
DOCREVIEW360_SIGNATURE_RATE_LIMIT=30
DOCREVIEW360_BULK_RATE_LIMIT=10

# Audit log HMAC integrity
# DOCREVIEW360_AUDIT_HMAC_KEY=change-this
# Set during key rotation — entries signed with the old key remain verifiable
# for the full retention window. Clear once old entries are purged.
# DOCREVIEW360_AUDIT_HMAC_KEY_PREVIOUS=old-audit-key

# Signatures
# DOCREVIEW360_SIGNATURE_SECRET=change-this
# DOCREVIEW360_ALLOW_SIGNATURE_FALLBACK=true
# SIGNATURE_PROVIDER=sandbox
# SIGNATURE_PROVIDER_PRIMARY=sandbox
# SIGNATURE_PROVIDER_FALLBACK=documenso,local

# Integrations
# DOCREVIEW360_SHAREPOINT_TIMEOUT_SECONDS=15
# Keycloak MFA (stub only — disabled in production until real integration is complete)
# DOCREVIEW360_ENABLE_KEYCLOAK=1

# ML / AI pipeline
# DOCREVIEW360_ML_MODEL_DIR=/app/artifacts/packages/2024-05-01_120000
# DOCREVIEW360_ML_PROVIDER=cpu
# DOCREVIEW360_ML_THREADS=4

# Celery workers (required in production; memory:// only for dev/test)
# CELERY_BROKER_URL=redis://redis:6379/0
# CELERY_RESULT_BACKEND=redis://redis:6379/1
# CELERY_EAGER=0

# E2E
# DOCREVIEW360_E2E_MODE=1
