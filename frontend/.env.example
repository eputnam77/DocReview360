NEXT_PUBLIC_API_BASE=http://localhost:8000 # leave blank to use dashboard host

# OpenRouter demo configuration (used by /api/ai-suggest)
# Sign up at https://openrouter.ai/ and create an API key
OPENROUTER_API_KEY=sk-or-...

# Optional: choose a model. Defaults to "openrouter/auto" which prefers free models
# See https://openrouter.ai/docs/models for options
# OPENROUTER_MODEL=openrouter/auto

# Used for OpenRouter HTTP-Referer header (helps with rate limits)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

