{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "jsx": "preserve",
    "moduleResolution": "node",
    "incremental": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./*"
      ],
      "lucide-react": [
        "./components/icons"
      ]
    },
    "allowJs": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx"
  ],
  "exclude": [
    "node_modules"
  ]
}
