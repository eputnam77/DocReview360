{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "strict": true,
    "moduleResolution": "node",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "lib": ["es2022", "dom"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["frontend/*"],
      "lucide-react": ["frontend/components/icons"]
    }
  },
  "include": ["plugins/**/*.ts", "frontend/**/*.ts", "frontend/**/*.tsx"]
}
