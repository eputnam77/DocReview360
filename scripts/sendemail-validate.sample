#!/usr/bin/env bash
# Simple git send-email validation hook.
# Requires `codespell` and `gitlint` to be available in PATH.

PATCH_FILE="$1"

[ -n "$PATCH_FILE" ] || exit 0

codespell --quiet-level=3 "$PATCH_FILE" || exit 1
gitlint --msg-filename "$PATCH_FILE" || exit 1
python -m docreview360.git_hooks "$PATCH_FILE" || exit 1
